# 环境变量清单（只有键名，不含任何真值）
#
# 真值只活在两处：GitHub Secrets（CI 用）与目标机 /root/.../.env（600 权限）。
# 本文件的作用是"说清需要哪些键"，让新接手的人知道要配什么，而不是把值写进仓。
#
# 用法：
#   cp .env.example .env && chmod 600 .env && $EDITOR .env
#   .env 已被 .gitignore 忽略（见 .gitignore）
#
# 提交前自检：`gitleaks dir . --redact -c .gitleaks.toml`（CI 也会跑，见 secret-hygiene.yml）

# ── 华为云（开关机 + 推拉 SWR）────────────────────────────────
HCLOUD_AK=
HCLOUD_SK=

# ── OBS（产物归档）───────────────────────────────────────────
OBS_AK=
OBS_SK=
OBS_ENDPOINT=
OBS_PREFIX=

# ── 权重下载 ─────────────────────────────────────────────────
HF_TOKEN=
HF_ENDPOINT=

# ── 机器访问（SSH 到 V100 runner）─────────────────────────────
# 优先用 key（TSSH_KEY 指向私钥路径）；只有密码时才用 SSHPASS
SSHPASS=
TSSH_KEY=
TSSH_PORT=

# ── 可选：本地跑脚本时指定 registry（默认按仓内路径找）────────
MODEL_REGISTRY=
