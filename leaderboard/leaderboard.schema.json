{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "partner-vla-eval leaderboard entries",
  "description": "一行一个 (model × task × protocol)。数字必须能在 docs/data/*.json 里找到；缺 ckpt_revision 或 n/success 不自洽即红。",
  "type": "object",
  "required": [
    "last_updated",
    "bench",
    "protocol",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "last_updated": {
      "type": "string",
      "format": "date"
    },
    "bench": {
      "type": "string",
      "enum": [
        "robotwin",
        "libero",
        "calvin"
      ]
    },
    "protocol": {
      "type": "string",
      "description": "考场条件，如 easy-demo_clean / hard-demo_randomized"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "model",
          "task",
          "n",
          "success",
          "errors",
          "weight_type",
          "replicate_count",
          "run",
          "date",
          "ckpt_repo",
          "ckpt_revision",
          "bench_image",
          "serve_image"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "task": {
            "type": "string",
            "minLength": 1
          },
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "success": {
            "type": "integer",
            "minimum": 0
          },
          "errors": {
            "type": "integer",
            "minimum": 0
          },
          "weight_type": {
            "type": "string",
            "enum": [
              "shared",
              "finetuned"
            ],
            "description": "shared=全 benchmark 同一 ckpt；finetuned=在本 benchmark 数据上训过"
          },
          "regime": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "clean50",
              "clean50+rand500",
              null
            ],
            "description": "finetuned 时的训练数据口径"
          },
          "replicate_count": {
            "type": "integer",
            "minimum": 1,
            "description": "1=单轮，榜单需标'勿作结论'"
          },
          "run": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "GitHub Actions run id"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "ckpt_repo": {
            "type": "string",
            "minLength": 3
          },
          "ckpt_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "HF commit sha（40 hex），不许只写分支名"
          },
          "bench_image": {
            "type": "string",
            "minLength": 3
          },
          "serve_image": {
            "type": "string",
            "minLength": 3
          },
          "digest": {
            "type": [
              "string",
              "null"
            ],
            "description": "镜像 sha256:...，未锁时为 null"
          },
          "harness_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "report": {
            "type": "string",
            "description": "对应 docs/data/*.json 路径"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "ranked_separately": {
      "type": "boolean",
      "description": "shared 与 finetuned 同文件并列时置 true，声明两者分别排名；缺省则混排即错。"
    }
  }
}
