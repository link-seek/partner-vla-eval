# RobotWin EE 验证镜像（#6 PR 验证用，非卖品）：
# base = SWR 0.8.0 stock + 上游 PR #168 等价补丁（docker/robotwin-ee.patch，
# 与 fork 分支 robotwin-action-type-ee 功能一致，已 diff 确认）。
# 构建：免费机（有外网；git 基镜像自带）。V100 只拉取。
FROM swr.cn-north-4.myhuaweicloud.com/link-seek/vla-eval-robotwin:0.8.0
COPY docker/robotwin-ee.patch /tmp/robotwin-ee.patch
RUN cd /workspace && git apply /tmp/robotwin-ee.patch \
 && conda run --no-capture-output -n robotwin python -c \
      "import vla_eval.benchmarks.robotwin.benchmark as b, inspect; assert 'action_type' in str(inspect.signature(b.RoboTwinBenchmark.__init__)), 'patch missing'; print('EE PATCH OK')"
ENTRYPOINT ["conda", "run", "--no-capture-output", "-n", "robotwin", "vla-eval"]
CMD ["run", "--config", "/workspace/configs/robotwin_eval.yaml"]
