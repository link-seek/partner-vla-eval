# RobotWin 统一运行镜像（议题 F 定盘，4→1）：
# = slim 三刀（资产外置 / nvcc 多阶段 / curobo 源码清）+ EE 烘进。
# 与 slim 的唯一区别：harness 不再 COPY 本仓 src，而是 pip 从追踪仓 EE 分支装
# （议题 H：研究仓不 vendoring 上游源码；EE 默认 qpos，与现跑行为一致，ee 走 config 切）。
# 上游基准：Dockerfile.robotwin@0.8.0（ROBOTWIN_REF=c3ddfa8，CUROBO_REF=v0.7.8）。
# 构建（须外网：免费机/hw21；V100 内网不能打；arch 显式指定，无需真卡）：
#   docker build -f docker/Dockerfile.robotwin-unified -t vla-eval-robotwin:0.8.0-ee-slim .
# 验收：grab_roller×10（EE 口径通）+ place_empty_cup×10（qpos 默认，0/10 噪声带）。

ARG BASE_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base:latest
ARG HARNESS_FORK=https://github.com/link-seek/vla-evaluation-harness.git
ARG HARNESS_UNIFIED_REF=9b5e45f55ba1aace6aacb50048e368e85fe0251d

# ---------- builder：含 nvcc，编 CuRobo ----------
FROM ${BASE_IMAGE} AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
        cuda-nvcc-12-6 cuda-cudart-dev-12-6 ninja-build \
    && rm -rf /var/lib/apt/lists/*
ENV CUDA_HOME=/usr/local/cuda-12.6
ENV PATH=/usr/local/cuda-12.6/bin:$PATH
RUN conda create -n robotwin python=3.10 pip -y && conda clean -afy
SHELL ["conda", "run", "-n", "robotwin", "/bin/bash", "-c"]
RUN uv pip install --no-cache-dir \
        "torch==2.4.1" "torchvision" \
        --torch-backend cu121
RUN uv pip install --no-cache-dir "setuptools<70"
RUN uv pip install --no-cache-dir \
        "sapien==3.0.0b1" \
        "mplib==0.2.1" \
        "transforms3d==0.4.2" \
        "scipy==1.10.1" \
        "gymnasium==0.29.1" \
        "trimesh==4.4.3" \
        "imageio==2.34.2" \
        "open3d==0.18.0" \
        "pydantic" \
        "h5py" \
        "pyyaml" \
        "termcolor" \
        "matplotlib" \
        "Pillow" \
        "huggingface_hub==0.25.0"
RUN SAPIEN_LOC=$(python -c "import sapien; print(sapien.__path__[0])") && \
    sed -i -E 's/("r")(\))( as)/\1, encoding="utf-8") as/g' \
        "$SAPIEN_LOC/wrapper/urdf_loader.py"
RUN MPLIB_LOC=$(python -c "import mplib; print(mplib.__path__[0])") && \
    sed -i -E \
        's/(if np.linalg.norm\(delta_twist\) < 1e-4 )(or collide )(or not within_joint_limit:)/\1\3/g' \
        "$MPLIB_LOC/planner.py"
ARG ROBOTWIN_REF=c3ddfa8b97d5519efa828b075999bd0006778e5e
RUN mkdir -p /app/RoboTwin \
    && cd /app/RoboTwin \
    && git init -q \
    && git remote add origin https://github.com/RoboTwin-Platform/RoboTwin.git \
    && git fetch -q --depth 1 origin "${ROBOTWIN_REF}" \
    && git checkout -q FETCH_HEAD \
    && rm -rf /app/RoboTwin/.git
# No GPU visible during build → arch explicit (V100-only).
ARG TORCH_CUDA_ARCH_LIST="7.0"
ENV TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST}
ARG CUROBO_REF=v0.7.8
RUN uv pip install --no-cache-dir "warp-lang==1.12.0"
RUN uv pip install --no-cache-dir wheel \
    && cd /app/RoboTwin/envs \
    && mkdir -p curobo \
    && cd curobo \
    && git init -q \
    && git remote add origin https://github.com/NVlabs/curobo.git \
    && git fetch -q --depth 1 origin "${CUROBO_REF}" \
    && git checkout -q FETCH_HEAD \
    && uv pip install --no-cache-dir --no-build-isolation . \
    && cd /app/RoboTwin/envs && rm -rf curobo
# 注意：故意跳过资产下载 + update_embodiment_config_path（资产运行时挂载后做）

# ---------- final：无 nvcc ----------
FROM ${BASE_IMAGE}
ARG HARNESS_FORK
ARG HARNESS_UNIFIED_REF
# P2 补丁烘进镜像（构建机外网可达 raw；V100 出境只认 github.com，运行时现拉必死）
ARG HARNESS_PATCH_BASE=https://raw.githubusercontent.com/link-seek/vla-evaluation-harness
# 注意：必须与 HARNESS_UNIFIED_REF 同源（pip 装什么就烘什么；曾用 P2-only 分支盖掉 EE，见 10-26 教训）
ARG HARNESS_PATCH_REF=9b5e45f55ba1aace6aacb50048e368e85fe0251d
RUN mkdir -p /opt/patches && cd /opt/patches \
 && curl -fsSL "${HARNESS_PATCH_BASE}/${HARNESS_PATCH_REF}/scripts/run_sharded.sh" -o run_sharded.sh \
 && curl -fsSL "${HARNESS_PATCH_BASE}/${HARNESS_PATCH_REF}/src/vla_eval/benchmarks/robotwin/benchmark.py" -o robotwin_benchmark_state.py \
 && chmod +x run_sharded.sh \
 && grep -c "sidecar" robotwin_benchmark_state.py
# conda env 整体搬运（含 torch/curobo wheel 产物）
COPY --from=builder /opt/conda/envs/robotwin /opt/conda/envs/robotwin
# RoboTwin 代码（无 .git、无 curobo 源码、无 assets）
COPY --from=builder /app/RoboTwin /app/RoboTwin
SHELL ["conda", "run", "-n", "robotwin", "/bin/bash", "-c"]
WORKDIR /workspace
# harness 从追踪仓 EE 分支装（含 action_type 开关，默认 qpos）；再验 EE 入口存在
ARG HARNESS_VERSION=0.0.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${HARNESS_VERSION}
RUN uv pip install --no-cache-dir "git+${HARNESS_FORK}@${HARNESS_UNIFIED_REF}" \
 && conda run --no-capture-output -n robotwin python -c \
      "import vla_eval.benchmarks.robotwin.benchmark as b, inspect; assert 'action_type' in str(inspect.signature(b.RoboTwinBenchmark.__init__)), 'EE missing'; print('EE OK')"
# P2 补丁直接盖掉装好的 benchmark（统一镜像恒带 instrumentation；entrypoint 的 STATE_PATCH 条件保留当幂等复写）
RUN SP=$(conda run --no-capture-output -n robotwin python -c "import vla_eval.benchmarks.robotwin.benchmark as m; print(m.__file__)") \
 && cp /opt/patches/robotwin_benchmark_state.py "$SP" \
 && conda run --no-capture-output -n robotwin python -c "import vla_eval.benchmarks.robotwin.benchmark as b, inspect; assert 'action_type' in str(inspect.signature(b.RoboTwinBenchmark.__init__)), 'EE LOST by P2 bake'; assert hasattr(b.RoboTwinBenchmark, '_dump_state_snapshot'), 'P2 LOST'; print('UNIFIED OK: EE+P2')"
# 我们的 run 配置（研究仓资产，非上游源码）
COPY configs/ configs/
# entrypoint：资产就绪 + STATE_PATCH 激活（见 docker/entrypoint-robotwin.sh）
COPY docker/entrypoint-robotwin.sh /usr/local/bin/vla-eval-entry
RUN chmod +x /usr/local/bin/vla-eval-entry
ENTRYPOINT ["/usr/local/bin/vla-eval-entry"]
CMD ["run", "--config", "/workspace/configs/robotwin_eval.yaml"]
