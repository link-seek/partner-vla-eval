# RoboTwin 官方 ACT / DP 的 serve 镜像（同一个 Dockerfile，POLICY 切换）
#
# 为什么需要它：适配器 scripts/model_servers/robotwin_policy.py 之前是**本地挂载**进容器的
# （-v /root/r01/mnt/model_servers），跑得通但不可复现 —— 挂载内容在机器上、不在镜像里，
# 于是 registry 里 act-baseline/dp-baseline 只能是 pending（无 serve_image_digest）。
#
# 基镜像钉 digest（tag 会被重打，digest 不会）；与 configs/registry 里的 bench_image_digest 同源。
ARG BASE=swr.cn-north-4.myhuaweicloud.com/link-seek/vla-eval-robotwin@sha256:7cc969f19b7997e98f4cc3960ae2b5d0e8f1a81571510b8a38b2abf2733c39fb
FROM ${BASE}

ARG POLICY=act

USER root

# 适配器与它的零依赖转换模块放在同一目录，靠 PYTHONPATH 解决同级 import
# 适配器的**全部**本地依赖都要 COPY：漏一个，构建期只看 robotwin_obs 是发现不了的，
# 要等运行时 `from action_queue import ...` 才炸（2026-11-25 抽出公共件后踩到）。
# 下面有 packaging 门禁守着这份清单。
COPY scripts/model_servers/robotwin_policy.py /opt/serve/robotwin_policy.py
COPY scripts/model_servers/robotwin_obs.py /opt/serve/robotwin_obs.py
COPY scripts/model_servers/action_queue.py /opt/serve/action_queue.py
COPY scripts/model_servers/act_ckpt.py /opt/serve/act_ckpt.py

# DP（RoboTwin 官方 policy/DP 里的 vendored diffusion_policy）在 robotwin 环境里缺一批依赖。
# 2026-11-25 实测：只补 hydra/dill 不够，import 依次报 einops → torch.accelerator(diffusers 太新)。
# 最终可用组合（在 torch 2.4.1+cu121 / numpy 1.26.4 下实测 import 通过）：
#   hydra-core 1.3.8, dill 0.4.1, einops 0.8.2, zarr 2.18.3, numcodecs 0.13.1,
#   numba 0.60.0, atomics 1.0.3, diffusers 0.27.2   ← 0.41 需要 torch.accelerator(≥2.6)，不可用
# 推断路径**不需要** pytorch3d / r3m / robomimic / wandb / pygame / pymunk（import 测试证明）。
# ACT 不需要这些，故只在 POLICY=dp 时装。
# 只在构建期装（V100 上禁止现场 pip）。默认源失败时回落清华镜像（国内构建更快）。
RUN if [ "${POLICY}" = "dp" ]; then \
      conda run -n robotwin pip install --no-cache-dir \
        hydra-core==1.3.8 dill==0.4.1 einops==0.8.2 \
        "zarr==2.18.3" numcodecs==0.13.1 numba==0.60.0 atomics==1.0.3 diffusers==0.27.2 \
      || conda run -n robotwin pip install --no-cache-dir \
        --index-url https://pypi.tuna.tsinghua.edu.cn/simple \
        hydra-core==1.3.8 dill==0.4.1 einops==0.8.2 \
        "zarr==2.18.3" numcodecs==0.13.1 numba==0.60.0 atomics==1.0.3 diffusers==0.27.2; \
    fi

ENV PYTHONPATH=/opt/serve
ENV ROBOTWIN_POLICY=${POLICY}
WORKDIR /opt/serve

# 自检 1：转换模块可导入（纯 numpy，不需要 GPU）
RUN conda run -n robotwin python -c "import robotwin_obs; print('robotwin_obs OK', robotwin_obs.RESIZE_WH)"

# 自检 1b：适配器本体可导入——它的本地依赖（action_queue/act_ckpt/robotwin_obs）必须都齐。
# 这一条才是"COPY 漏了"的告警；只 import robotwin_obs 抓不到。
RUN cd /opt/serve && conda run -n robotwin python -c "import robotwin_policy; print('robotwin_policy OK')"

# 自检 2：DP 的依赖组合真的能导入官方 deploy_policy —— 让构建失败在镜像里，而不是等到 smoke。
# 2026-11-25 就是这么逐个试出来的（hydra/dill → einops → diffusers 版本），以后回归会直接红。
RUN if [ "${POLICY}" = "dp" ]; then \
      cd /app/RoboTwin && conda run -n robotwin python -c \
        "import policy.DP.deploy_policy as d; print('DP import OK:', d.get_model.__name__)"; \
    fi
