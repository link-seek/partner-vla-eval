# RoboTwin 瘦身实验版（#3-4，未构建验证，V100 上打）：
# 上游 Dockerfile.robotwin@0.8.0（ROBOTWIN_REF=c3ddfa8，CUROBO_REF=v0.7.8）三刀：
#  1. 删资产层（~15GB）：不下 objects/embodiments/background_texture.zip，
#     运行时挂载 /data/robotwin-assets/c3ddfa8（等价已验 45/50 vs 46/50）。
#     注意 update_embodiment_config_path.py 原在资产解包后跑——改到 entrypoint
#     包一层（资产挂载就绪后再跑，保证幂等），见 CMD。
#  2. nvcc 多阶段（省 2-3GB）：builder 装 cuda-nvcc-12-6 编 CuRobo，
#     final 只留 conda env（含 torch 自带的 cudart runtime）+ cudart 运行库。
#  3. CuRobo 源码清理（~1GB）：pip 装完删 /app/RoboTwin/envs/curobo
#    （wheel 已进 site-packages；若运行时 PYTHONPATH 引用该目录则构建失败即知）。
# torch/base 层动不得。目标 ~6GB/单镜像。
# 构建（须有外网处打：免费机或 hw21。V100 几乎内网不能打。
# CuRobo 编译的 GPU arch 用 TORCH_CUDA_ARCH_LIST 显式指定，无需真卡）：
#   docker build -f docker/Dockerfile.robotwin-slim -t vla-eval-robotwin:slim .
# 验收：grab_roller×50 落 46/50 的 ±8pp 内。

ARG BASE_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base:latest

# ---------- builder：含 nvcc，编 CuRobo ----------
FROM ${BASE_IMAGE} AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
        cuda-nvcc-12-6 cuda-cudart-dev-12-6 ninja-build \
    && rm -rf /var/lib/apt/lists/*
ENV CUDA_HOME=/usr/local/cuda-12.6
ENV PATH=/usr/local/cuda-12.6/bin:$PATH
RUN conda create -n robotwin python=3.10 pip -y && conda clean -afy
SHELL ["conda", "run", "-n", "robotwin", "/bin/bash", "-c"]
RUN uv pip install --no-cache-dir \
        "torch==2.4.1" "torchvision" \
        --torch-backend cu121
RUN uv pip install --no-cache-dir "setuptools<70"
RUN uv pip install --no-cache-dir \
        "sapien==3.0.0b1" \
        "mplib==0.2.1" \
        "transforms3d==0.4.2" \
        "scipy==1.10.1" \
        "gymnasium==0.29.1" \
        "trimesh==4.4.3" \
        "imageio==2.34.2" \
        "open3d==0.18.0" \
        "pydantic" \
        "h5py" \
        "pyyaml" \
        "termcolor" \
        "matplotlib" \
        "Pillow" \
        "huggingface_hub==0.25.0"
RUN SAPIEN_LOC=$(python -c "import sapien; print(sapien.__path__[0])") && \
    sed -i -E 's/("r")(\))( as)/\1, encoding="utf-8") as/g' \
        "$SAPIEN_LOC/wrapper/urdf_loader.py"
RUN MPLIB_LOC=$(python -c "import mplib; print(mplib.__path__[0])") && \
    sed -i -E \
        's/(if np.linalg.norm\(delta_twist\) < 1e-4 )(or collide )(or not within_joint_limit:)/\1\3/g' \
        "$MPLIB_LOC/planner.py"
ARG ROBOTWIN_REF=c3ddfa8b97d5519efa828b075999bd0006778e5e
RUN mkdir -p /app/RoboTwin \
    && cd /app/RoboTwin \
    && git init -q \
    && git remote add origin https://github.com/RoboTwin-Platform/RoboTwin.git \
    && git fetch -q --depth 1 origin "${ROBOTWIN_REF}" \
    && git checkout -q FETCH_HEAD \
    && rm -rf /app/RoboTwin/.git
# No GPU visible during build → arch explicit (ARG overridable; slim default V100-only).
ARG TORCH_CUDA_ARCH_LIST="7.0"
ENV TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST}
ARG CUROBO_REF=v0.7.8
RUN uv pip install --no-cache-dir "warp-lang==1.12.0"
RUN uv pip install --no-cache-dir wheel \
    && cd /app/RoboTwin/envs \
    && mkdir -p curobo \
    && cd curobo \
    && git init -q \
    && git remote add origin https://github.com/NVlabs/curobo.git \
    && git fetch -q --depth 1 origin "${CUROBO_REF}" \
    && git checkout -q FETCH_HEAD \
    && uv pip install --no-cache-dir --no-build-isolation . \
    && cd /app/RoboTwin/envs && rm -rf curobo
# 注意：故意跳过资产下载 + update_embodiment_config_path（资产运行时挂载后做）

# ---------- final：无 nvcc ----------
FROM ${BASE_IMAGE}
# conda env 整体搬运（含 torch/curobo wheel 产物）
COPY --from=builder /opt/conda/envs/robotwin /opt/conda/envs/robotwin
# RoboTwin 代码（无 .git、无 curobo 源码、无 assets）
COPY --from=builder /app/RoboTwin /app/RoboTwin
# cudart 运行库（torch pip 包自带 nvidia-cuda-runtime；缺啥构建期 import 即知）
SHELL ["conda", "run", "-n", "robotwin", "/bin/bash", "-c"]
WORKDIR /workspace
COPY pyproject.toml README.md ./
COPY src/ src/
ARG HARNESS_VERSION=0.0.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${HARNESS_VERSION}
RUN uv pip install --no-cache-dir -e .
COPY configs/ configs/
# entrypoint 包一层：资产挂载就绪后跑 embodiment 路径解析（幂等），再进 vla-eval
RUN printf '#!/bin/bash\nset -e\nif [ -d /app/RoboTwin/assets ]; then cd /app/RoboTwin && python script/update_embodiment_config_path.py >/dev/null 2>&1 || true; fi\nexec conda run --no-capture-output -n robotwin vla-eval "$@"\n' > /usr/local/bin/vla-eval-entry && chmod +x /usr/local/bin/vla-eval-entry
ENTRYPOINT ["/usr/local/bin/vla-eval-entry"]
CMD ["run", "--config", "/workspace/configs/robotwin_eval.yaml"]
