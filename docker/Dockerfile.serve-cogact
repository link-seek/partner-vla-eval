# DB-CogACT serve 镜像：V100 离线跑，依赖全烘，uv 缓存预热。
# 构建机要求外网（免费 runner）：clone + pip + uv 全要下载。
# 运行时（V100）零下载：UV_OFFLINE=1，harness/dexbotic/权重一律 baked 或挂载，
# 不许 git clone / pip / HF。
ARG HARNESS_REF=v0.7.0
ARG DEXBOTIC_REV=42f72859dfe48bb4c30a09ab151a018c2ca0700a
# 论文实验 B 用：float16（V100 默认）/ float32（对照组，build 时 --build-arg DTYPE=torch.float32）
# fp32 单卡 OOM（28GB 权重）：DEVICE_MAP=auto 时双卡分片（每卡 ~14GB），见下方 python 补丁。
ARG DTYPE=torch.float16
ARG DEVICE_MAP=
FROM python:3.12-slim
# 全局 ARG 进 stage 要重声明，否则展开为空（已踩坑）
ARG HARNESS_REF
ARG DEXBOTIC_REV
ARG DTYPE
ARG DEVICE_MAP
WORKDIR /work

RUN apt-get update && apt-get install -y --no-install-recommends \
      git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir --upgrade pip uv

# vla-eval CLI（serve 入口；纯 python，无 torch 依赖）
RUN pip install --no-cache-dir "vla-eval==0.7.0"

# harness 源码（serve yaml 用相对 script 路径，CWD=/work/harness）
RUN git clone --depth 1 --branch ${HARNESS_REF} \
      https://github.com/allenai/vla-evaluation-harness.git harness
# dexbotic（cogact header 原指 git，改本地 path 前先 vendoring）
RUN git clone https://github.com/MilkClouds/dexbotic.git dexbotic-src \
 && cd dexbotic-src && git checkout -q ${DEXBOTIC_REV} && cd ..

# V100 补丁（同 CI 历史，烘进镜像不再运行时 sed）：
# torch 钉 2.6.0 / transformers 钉 4.46.3 / 全 fp16 / python 放宽 / dexbotic 本地 path
RUN sed -i 's|dexbotic = { git = "https://github.com/MilkClouds/dexbotic.git", rev = "42f72859dfe48bb4c30a09ab151a018c2ca0700a" }|dexbotic = { path = "/work/dexbotic-src" }|' \
      harness/src/vla_eval/model_servers/dexbotic/cogact.py \
 && sed -i 's|"torch>=2.0"|"torch==2.6.0"|' \
      harness/src/vla_eval/model_servers/dexbotic/cogact.py \
 && sed -i 's|"transformers>=4.40,<5"|"transformers==4.46.3"|' \
      harness/src/vla_eval/model_servers/dexbotic/cogact.py \
 && sed -i "s|torch_dtype=torch.bfloat16|torch_dtype=${DTYPE}|" \
      harness/src/vla_eval/model_servers/dexbotic/cogact.py \
 && sed -i 's|requires-python = "~=3.11"|requires-python = ">=3.11"|' \
      harness/src/vla_eval/model_servers/dexbotic/cogact.py \
 && grep -nE '"torch==|"transformers==|torch_dtype=torch|dexbotic =|requires-python' \
      harness/src/vla_eval/model_servers/dexbotic/cogact.py
# 双卡分片（DEVICE_MAP=auto）：device_map 进 from_pretrained，去 .to()，
# 输入统一放 cuda:0（accelerate 按 hf_device_map 分发），model.device 全换输入设备。
RUN python3 <<'PYEOF'
import os
if os.environ.get("DEVICE_MAP"):
    p = "harness/src/vla_eval/model_servers/dexbotic/cogact.py"
    s = open(p).read()
    old_load = """        self._model = CogACTForCausalLM.from_pretrained(
            self.model_path,
            torch_dtype=torch.float32,
            trust_remote_code=True,
        ).to(self._device)"""
    new_load = """        self._model = CogACTForCausalLM.from_pretrained(
            self.model_path,
            torch_dtype=torch.float32,
            trust_remote_code=True,
            device_map="auto",
        )
        self._device = torch.device("cuda:0")"""
    assert s.count(old_load) == 1, "load block not found"
    s = s.replace(old_load, new_load)
    assert "self._model.device" in s
    s = s.replace("self._model.device", "self._device")
    open(p, "w").write(s)
    print("DEVICE_MAP patch OK")
else:
    print("single-device, skip")
PYEOF

# uv 缓存预热：跑一次 --help 即同步 env 进 /root/.cache/uv（随镜像层走）
ENV PIP_INDEX_URL=https://download.pytorch.org/whl/cu126
ENV PIP_EXTRA_INDEX_URL=https://pypi.org/simple
ENV UV_OFFLINE=0
RUN cd /work/harness \
 && uv run src/vla_eval/model_servers/dexbotic/cogact.py --help > /dev/null

WORKDIR /work/harness
CMD ["bash"]
